# Optional. Leave unset to use SQLite at server/data/taskflow.db (assignment default).
# DATABASE_URL=postgresql://user:password@host/dbname

# Optional. Set to 1 when the app is served over HTTPS.
# TASKFLOW_SECURE_COOKIES=1

# Optional. SQLite file path when DATABASE_URL is unset.
# TASKFLOW_DB_PATH=server/data/taskflow.db
